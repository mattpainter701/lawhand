*.sh text eol=lf
# The root-owned host entrypoints are extensionless, so `*.sh` never covered
# them. A CRLF checkout gives the installed file a `#!/usr/bin/env bash\r`
# shebang, and it then dies with `env: 'bash\r': No such file or directory`
# (exit 127) on its first run -- which is how the scheduled production DAST
# scan silently produced no report.
scripts/lawhand-* text eol=lf
*.pdf binary
